[
  {
    "match": "the tests are failing.*fix the bug",
    "steps": [
      {
        "tool": "bash",
        "args": {
          "command": "node --test"
        }
      },
      {
        "tool": "fs_edit",
        "args": {
          "path": "src/math.js",
          "oldText": "return a + b + 1;",
          "newText": "return a + b;"
        }
      },
      {
        "tool": "bash",
        "args": {
          "command": "node --test"
        }
      }
    ],
    "finalText": "[Mock] Found the off-by-one in add() (it added an extra 1) and fixed it \u2014 node --test now passes.\n"
  },
  {
    "match": "create a new project with three files",
    "steps": [
      {
        "tool": "fs_write",
        "args": {
          "content": "{\n  \"name\": \"scratch-project\",\n  \"type\": \"module\",\n  \"scripts\": { \"test\": \"node --test\" }\n}\n",
          "path": "package.json"
        }
      },
      {
        "tool": "fs_write",
        "args": {
          "content": "export function add(a, b) {\n  return a + b;\n}\n",
          "path": "src/math.js"
        }

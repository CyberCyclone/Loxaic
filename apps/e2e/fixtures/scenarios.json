          "command": "node --test"
        }
      },
      {
        "tool": "fs_edit",
        "args": {
          "path": "src/math.js",
          "oldText": "return a + b + 1;",
          "newText": "return a + b;"
        }
      },
      {
        "tool": "bash",
        "args": {
          "command": "node --test"
        }
      }
    ],
    "finalText": "[Mock] Found the off-by-one in add() (it added an extra 1) and fixed it \u2014 node --test now passes.\n"
  },

{
  "name": "@shannon/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.26",
    "@brave/brave-search-mcp-server": "2.1.3",
    "@fastify/cors": "^10.0.0",
    "@fastify/express": "^4.0.7",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@shannon/agent": "workspace:*",
    "@shannon/db": "workspace:*",
    "@shannon/sync": "workspace:*",
    "@shannon/types": "workspace:*",
    "ajv": "^8.20.0",
    "better-auth": "1.6.26",
    "dockerode": "^5.0.1",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "node-cron": "^4.6.0",
    "uuid": "^14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@shannon/config-ts": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^11.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

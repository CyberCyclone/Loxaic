{
  "name": "@loxaic/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "dotenv -e ../../.env -- expo start",
    "android": "dotenv -e ../../.env -- expo start --android",
    "ios": "dotenv -e ../../.env -- expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:web": "dotenv -e ../../.env -- expo export --platform web",
    "prebuild:ios": "dotenv -e ../../.env -- expo prebuild --platform ios",
    "prebuild:android": "dotenv -e ../../.env -- expo prebuild --platform android",
    "web": "dotenv -e ../../.env -- expo start --web",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo/html-elements": "^57.0.0",
    "@expo/metro-runtime": "~57.0.15",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@loxaic/api-client": "workspace:*",
    "@loxaic/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "expo": "~57.0.20",
    "expo-build-properties": "^57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-updates": "~57.0.21",
    "lucide-react-native": "^1.33.0",
    "marked": "^18.0.11",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@loxaic/config-ts": "workspace:*",
    "@types/react": "^19.2.18",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "^57.0.10",
    "dotenv-cli": "^7.4.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

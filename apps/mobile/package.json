{
  "name": "@shannon/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development dotenv -e ../../.env -- expo start",
    "android": "APP_VARIANT=development dotenv -e ../../.env -- expo start --android",
    "ios": "APP_VARIANT=development dotenv -e ../../.env -- expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:web": "dotenv -e ../../.env -- expo export --platform web",
    "web": "dotenv -e ../../.env -- expo start --web",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/public-sans": "^0.4.2",

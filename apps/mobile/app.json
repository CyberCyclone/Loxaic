{
  "expo": {
    "name": "loxaic",
    "slug": "loxaic",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "loxaic",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#13161a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loxaic.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationDefaultAccuracyReduced": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#13161a"
      },
      "package": "com.loxaic.app",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#13161a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Loxaic uses your photo library to attach images to a message.",
          "cameraPermission": "Loxaic uses your camera to attach a photo to a message."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Loxaic shares your approximate location with a conversation only when you allow it, so the assistant can answer for where you are.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "021a4960-4d9d-46e0-bd6a-7437d95e0fab"
      }
    },
    "owner": "caseygibson",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/021a4960-4d9d-46e0-bd6a-7437d95e0fab",
      "checkAutomatically": "ON_ERROR_RECOVERY"
    }
  }
}

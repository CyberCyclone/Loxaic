{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "dev": {
      "distribution": "internal",
      "channel": "dev",
      "environment": "development",
      "env": { "APP_VARIANT": "dev" },
      "android": { "buildType": "apk" }
    },
    "beta": {
      "channel": "beta",
      "environment": "preview",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "beta" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" },
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {}
  }
}

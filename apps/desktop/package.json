{
  "name": "@loxaic/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build:web": "pnpm --filter @loxaic/mobile export:web",
    "build:tsnet-proxy": "bash ../../infra/tsnet-proxy/build.sh resources/tsnet-proxy",
    "build:server": "node scripts/build-server.mjs",
    "package": "pnpm build:web && pnpm build:tsnet-proxy && pnpm build:server && electron-builder",
    "package:dir": "mkdir -p resources/tsnet-proxy && pnpm build:web && pnpm build:server && electron-builder --dir",
    "typecheck": "echo ok",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-serve": "^3.0.1",
    "embedded-postgres": "17.10.0-beta.17"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.loxaic.desktop",
    "productName": "Loxaic",
    "npmRebuild": false,
    "asar": false,
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      { "from": "../mobile/dist", "to": "web" },
      { "from": "resources/tsnet-proxy", "to": "tsnet-proxy" },
      { "from": "resources/server", "to": "server" }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": { "target": "nsis" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  }
}

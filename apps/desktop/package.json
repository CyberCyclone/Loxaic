{
  "name": "@shannon/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build:web": "pnpm --filter @shannon/web build",
    "package": "pnpm build:web && electron-builder",
    "typecheck": "echo ok"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.shannon.desktop",
    "productName": "Open-Shannon",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      { "from": "../web/dist", "to": "web" }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage", "category": "Development" }
  }
}
{
  "name": "open-shannon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "stable:up": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build",
    "stable:down": "docker compose -f docker-compose.prod.yml --env-file .env.prod down",
    "stable:logs": "docker compose -f docker-compose.prod.yml --env-file .env.prod logs -f server",
    "stable:ps": "docker compose -f docker-compose.prod.yml --env-file .env.prod ps"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.4.1",
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^17.11.0",
    "turbo": "^2.10.9",
    "typescript-eslint": "^8"
  }
}

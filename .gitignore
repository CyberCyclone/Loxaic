node_modules/
dist/
.turbo/
.env
# Every env file except the committed examples — .env.prod in particular holds a
# real BETTER_AUTH_SECRET.
.env.*
!.env*.example
*.env
*.local
models/
.expo/
*.tgz
apps/desktop/resources/
apps/desktop/dist/
apps/e2e/.appium/
# Generated by `expo prebuild` — app.json stays the source of truth (CNG).
apps/mobile/ios/
apps/mobile/android/

# Keys from `expo-updates codesigning:generate`. Update signing is not in use —
# EAS restricts it to Enterprise, see AGENTS.md — but a key generated while
# trying it can still be sitting here, and a private key must never become a
# commit.
apps/mobile/keys/
# Uploaded attachments. UPLOADS_DIR is unset in dev, so storage.ts
# falls back to <cwd>/uploads — i.e. inside the working tree. These are
# real user images and must never be committed.
apps/server/uploads/
uploads/
# The managed llama.cpp runtime and downloaded models: LLAMA_DIR, which falls
# back to <cwd>/llama the same way. Many gigabytes; never commit.
apps/server/llama/

# `go build` with no -o drops a binary named after the module in the package
# directory; build.sh always writes to an explicit output dir instead.
/infra/tsnet-proxy/tsnet-proxy

# macOS Finder metadata
.DS_Store

# Credentials that must never become a commit: signing certificates and keys,
# keystores, and service-account / Firebase config files.
*.p8
*.p12
*.pem
*.keystore
*.jks
credentials.json
secrets.json
service-account*.json
google-services.json
GoogleService-Info.plist

# Test run output at any depth — apps/e2e/artifacts/ above all, where e2e
# screenshots land and must never be committed.
artifacts/

# Env file for the stable/production stack (docker-compose.prod.yml).
# Copy to .env.prod (gitignored) and fill in real values:
#   cp .env.prod.example .env.prod
#   pnpm stable:up
#
# This is separate from the root .env used by the dev stack — the two never
# share a value, so dev and stable can run at once without stepping on each
# other's ports, database, or secrets.

# Host ports for the stable stack (defaults shown — the 41xx block, i.e. dev
# port + 100). Only change these if they collide with something else already
# running on this machine.
STABLE_PORT=4100
STABLE_DB_PORT=5433
STABLE_NTFY_PORT=4103

# Required — a real secret, distinct from dev's BETTER_AUTH_SECRET.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Encryption key for stored MCP server credentials (see docs/RUNTIME.md).
# Generate one with: openssl rand -base64 32
MCP_ENCRYPTION_KEY=

# Public URL of the stable server as seen by clients (native apps, browsers
# on other devices). e.g. http://192.168.1.50:4100 or, with Tailscale Serve,
# https://<machine>.<tailnet>.ts.net
BETTER_AUTH_URL=http://localhost:4100

# Comma-separated list of extra origins better-auth should trust, beyond the
# built-in localhost dev defaults — needed for sign-in from stable's LAN/
# tailnet URL. e.g. http://192.168.1.50:4100,https://shannon.tailnet.ts.net
TRUSTED_ORIGINS=

# Same meaning as in .env.example — used for native app endpoint discovery.
PUBLIC_API_URL=
LAN_API_URL=

# Inference backend. Defaults to reaching the same llama.cpp instance dev
# uses via host.docker.internal — see the usage note at the top of
# docker-compose.prod.yml for the trade-off, and how to run a dedicated
# instance instead. If you're pointing at LM Studio on the host, use
# http://host.docker.internal:1234.
INFERENCE_BASE_URL=http://host.docker.internal:4002
MOCK_INFERENCE=false

# Tailscale sidecar (optional, only for docker-compose.tailscale.yml)
TS_AUTHKEY=

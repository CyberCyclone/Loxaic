# Server
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loxaic
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4000
MOCK_INFERENCE=true

# Local models — the llama.cpp runtime this server downloads and runs itself.
# An admin sets it up under Settings > Local models; nothing here is required.
# managed (default): this server installs llama.cpp and runs it.
# attach: something else runs it (Compose's `inference` sidecar) at LLAMA_ROUTER_URL.
# off: no local models; only added providers.
LLAMA_MODE=
# Where the runtime and downloaded models live. Defaults to ./llama beside the
# server (gitignored). Many gigabytes.
LLAMA_DIR=
# Pins the runtime's backend (auto|metal|cuda|vulkan|rocm|cpu) and makes the
# admin control read-only. `auto` never picks the CPU.
LLAMA_BACKEND=
# For gated HuggingFace models (Llama, Gemma, …). Can also be set in the GUI.
HF_TOKEN=
# INFERENCE_BASE_URL is no longer read: a deployment that still sets it gets
# that backend converted once into an added provider (Settings > Model
# Providers). Add other backends there.

# Comma-separated emails granted the admin role on sign-up, in addition to
# whichever user registers first (which always becomes admin). Also the
# recovery path for an existing deployment: add an email here and have that
# user sign up again, or run `UPDATE "user" SET role='admin' WHERE email=...`.
# A forgotten password is reset from Admin → Users, or on this machine with
# `pnpm --filter @loxaic/server reset-password <email>` — see docs/DEPLOY.md,
# "Resetting a password".
ADMIN_EMAILS=
# Encrypts MCP server credentials at rest (aes-256-gcm). Falls back to
# BETTER_AUTH_SECRET with a warning — set it explicitly so credential
# encryption survives auth-secret rotation.
MCP_ENCRYPTION_KEY=

# Extra origins better-auth should trust, comma-separated — appended to the
# built-in defaults (localhost:4000/4001, the packaged Electron renderer).
# Needed if the web app is served from a different origin than the API.
TRUSTED_ORIGINS=

# Migrations — advanced; the desktop supervisor sets these itself, you
# normally won't need to.
# Absolute path to the migrations folder, overriding the default cwd-relative
# lookup (packages/db/drizzle, resolved against process.cwd()).
MIGRATIONS_DIR=
# Turn a failed/skipped migration at boot into a fatal error instead of a
# warning — set by the desktop supervisor so a broken migration can't leave a
# server silently running against a stale schema.
MIGRATIONS_STRICT=

# Image attachments
# Where uploaded images are written. Unset falls back to <cwd>/uploads, which
# in a repo checkout means apps/server/uploads — inside the working tree, and
# gitignored for exactly that reason. Point this somewhere outside the repo
# (or at a volume) for anything longer-lived than a dev session. The Docker
# compose stack and the desktop supervisor both set it themselves.
UPLOADS_DIR=
# Total bytes of attachments one user may keep on disk. Uploads past this are
# rejected with 413. Unset uses the built-in default (1 GiB).
ATTACHMENT_USER_QUOTA_BYTES=
# How long an uploaded image that no message references is kept before the
# orphan sweep deletes it — i.e. "picked, then never sent".
ATTACHMENT_ORPHAN_GRACE_HOURS=24

# Stream log (durable, resumable message streaming — see AGENTS.md, "Streaming (the stream log)")
# "memory" is the zero-dependency single-instance dev default; it does not
# survive a server restart. "redis" is required for orphan-stream recovery
# after a crash.
STREAM_BACKEND=memory
REDIS_URL=redis://localhost:6379
# Producer-side micro-batching window for token deltas, in ms.
STREAM_COALESCE_MS=25
# How long a finished/idle stream is kept before expiring from the stream
# backend.
STREAM_TTL_SECONDS=86400

# Container engine (agent sandboxes)
#
# Everything in this block is OPTIONAL and acts as an override: an admin can
# set the same things from the GUI (Settings → Agent Sandbox), which persists
# them in the server_settings table. Precedence is env > stored > default, so
# anything set here is pinned and shows as read-only in the GUI. Leave the
# block empty to make the sandbox fully configurable from the app.
#
# Path to a Docker-API-compatible socket. Works with Docker Desktop, Podman,
# OrbStack, and Colima — see docs/RUNTIME.md.
# Leave empty for the default (/var/run/docker.sock).
# Examples:
#   Podman (Linux):  /run/user/1000/podman/podman.sock
#   Podman (macOS):  ~/.local/share/containers/podman/machine/podman.sock
#   Colima:          ~/.colima/default/docker.sock
CONTAINER_SOCKET=
# How agent tool calls (bash, fs_read/write/edit, grep, glob) run:
#   container (default) — isolated via the engine above.
#   host — no isolation, runs directly on this machine. An explicit opt-in;
#          logs a warning at boot and on first use.
#   off  — sandboxed tools are disabled entirely.
SANDBOX_MODE=container
# Where host-mode sandboxes live on disk. Defaults to <LOXAIC_DATA_DIR>/sandboxes,
# or ./sandboxes if LOXAIC_DATA_DIR is unset. Ignored in container mode.
SANDBOX_HOST_ROOT=
# Override the image tag agent sandboxes run in (default: loxaic-sandbox).
SANDBOX_IMAGE=
# Give sandbox containers network access (1/true/yes). Off by default: an
# agent sandbox runs model-directed commands, so an outbound network is an
# exfiltration path. Turn it on when the agent genuinely needs to install
# dependencies. Host-mode sandboxes always have the host's network.
SANDBOX_ALLOW_NETWORK=
# How many sandboxes one user may hold at once. Every other limit (memory,
# CPU, pids) is per container, so without this one user with many open
# conversations can hold several times the whole budget on a shared host.
SANDBOX_MAX_PER_USER=5

# Remote access (see docs/REMOTE_ACCESS.md)
# Public HTTPS URL of this server as seen by remote clients.
# With Tailscale Serve this is https://<machine>.<tailnet>.ts.net
PUBLIC_API_URL=
# Direct LAN URL for clients on the same network (native apps prefer this
# when reachable), e.g. http://192.168.1.50:4000
LAN_API_URL=

# Expo app defaults (read at bundle time by apps/mobile)
# Native apps probe LAN first, then fall back to the public/tailnet URL.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_LAN_API_URL=

# Tailscale sidecar (optional, only for docker-compose.tailscale.yml)
# Create an auth key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Deprecated: use PUBLIC_API_URL instead
TAILSCALE_HOST=

# Self-contained desktop app (see docs/DEPLOY.md) — only read by the
# Electron app / headless.js, not by a plain `pnpm dev` server. Everything
# below is optional; the app works with none of it set.
# Port the embedded server listens on.
LOXAIC_PORT=4100
# Where the app stores its embedded Postgres data + generated secrets.
# Defaults to the platform user-data dir (e.g. ~/Library/Application
# Support/Loxaic on macOS) — the same directory the GUI and headless
# entry points share by default.
LOXAIC_DATA_DIR=
# Skip the embedded stack entirely and connect to a Loxaic server running
# elsewhere (same effect as the app's --remote=<url> flag).
LOXAIC_REMOTE_URL=
